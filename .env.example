# Copy to .env (git-ignored). Every variable has a default (src/rag_load_test/config/rag_settings.py).
RAG_TOPOLOGY=monolith        # monolith | split-reranker | split-all
# RAG_RUN_LABEL=             # default: topology + each choice off its default, e.g. monolith+rerank=none

# The model components (embedder, reranker, llm) are declared in the workflow
# file (see below): each states its backend (local in this process, api for an
# endpoint, fake, or none for the reranker), its source id (the weights) and its
# alias (the name a model server serves it under: the source id's last part
# unless set), and one block of settings per backend. Their values stay there;
# a variable named by a value's path, its levels joined by __, overrides one.
# The topology moves the embedder and the reranker from local behind a model
# server (api); api, fake and none are kept. An API key is set here or in the
# environment, never in the workflow file.
RAG_COMPONENTS__LLM__API__API_KEY=            # the generation endpoint's key
# RAG_COMPONENTS__LLM__BACKEND=fake             # api | fake
# RAG_COMPONENTS__LLM__HTTP__TIMEOUT_S=120      # an answer takes longer than a model-server call
# RAG_COMPONENTS__EMBEDDER__BACKEND=fake        # local | api | fake
# RAG_COMPONENTS__EMBEDDER__API__URL=           # e.g. http://host:8000/v3/embeddings
# RAG_COMPONENTS__EMBEDDER__API__API_KEY=       # empty | domino | <bearer token>
# RAG_COMPONENTS__EMBEDDER__LOCAL__THREADS=0    # 0 = calibrated at start-up
# RAG_COMPONENTS__RERANKER__BACKEND=none        # local | api | fake | none
# RAG_COMPONENTS__RERANKER__API__URL=           # e.g. http://host:8000/v3/rerank
# RAG_COMPONENTS__RERANKER__API__API_KEY=
# RAG_COMPONENTS__RERANKER__LOCAL__BATCH_SIZE=0 # 0 = calibrated at start-up
# RAG_COMPONENTS__RERANKER__LOCAL__THREADS=0
# RAG_COMPONENTS__RERANKER__LOCAL__CALIBRATION_PASSAGES=20  # calibration's rerank request; bounds the batch sizes tried

# RAG_LOCAL_MODEL_RUNTIME=openvino    # openvino | torch: what runs the in-process models
# RAG_OPENVINO_MODELS_DIR=models/openvino   # where rag-export-openvino writes

RAG_VECTOR_STORE_BACKEND=elasticsearch # elasticsearch | chroma | fake (in-memory, seeded at start-up)
RAG_ES_URL=http://localhost:9200       # http://user:password@host:9200 for basic auth
RAG_ES_API_KEY=
# RAG_ES_TEXT_ANALYZER=standard        # or a language's, e.g. french; an index keeps the one it was created with
# RAG_CHROMA_PATH=chroma               # embedded Chroma's folder (pip install -e ".[chroma]")
# RAG_CHROMA_URL=                      # a Chroma server instead, e.g. http://localhost:8000
# RAG_CHROMA_COLLECTION=rag_passages

# The components and the graph, its stages and their own settings (retrieval
# mode, sizes, prompts), are read from a workflow file: the one RAG_WORKFLOW_FILE
# names (environment only: it is not read from this file), else workflow.yaml in
# the working directory, else the one that ships with the code
# (src/rag_load_test/config/workflow.yaml). Lexical retrieval is a file without
# the embed stage. A variable named by a value's path, its levels joined by __,
# overrides that value of the file:
# RAG_GRAPH__STAGES__RETRIEVE__RETRIEVAL_MODE=dense   # dense | lexical | hybrid
# RAG_GRAPH__STAGES__RETRIEVE__TOP_K=20               # candidates from the store
# RAG_GRAPH__STAGES__RETRIEVE__RRF_K=60               # rank constant of the hybrid fusion
# RAG_GRAPH__STAGES__RERANK__TOP_K=10                 # passages kept and sent to the LLM
# RAG_GRAPH__STAGES__GENERATE__SYSTEM_PROMPT="..."
# RAG_GRAPH__STAGES__GENERATE__USER_PROMPT="... {context} ... {question}"

RAG_DOMINO_TRACING=false
# host/port are rag-serve flags (default 0.0.0.0:8888, what Domino apps need)

# locust (client side); a model-server target also reads
# RAG_COMPONENTS__RERANKER__ALIAS and RAG_COMPONENTS__EMBEDDER__ALIAS (default: the
# workflow file's aliases), and RAG_TOP_K_RETRIEVE / RAG_TOP_K_RERANK
# (documents and top_n of a rerank request, default 20 and 10; the workflow app
# no longer reads them)
# RAG_LOADTEST_TARGET=rag             # rag | rerank | embeddings (a model server directly)
# RAG_LOADTEST_BEARER_TOKEN=          # Authorization: Bearer ... (from inside Domino)
# DOMINO_API_KEY=                     # X-Domino-Api-Key: ... (from a laptop)
# RAG_LOADTEST_QUERY_WEIGHT=1
# RAG_LOADTEST_RETRIEVE_WEIGHT=3
# RAG_LOADTEST_WAIT_MIN_S=0.2         # each user waits between min and max seconds between requests
# RAG_LOADTEST_WAIT_MAX_S=1.0
# RAG_LOADTEST_SHAPE=step             # step or unset
# RAG_LOADTEST_STEP_USERS=5,10,20,40  # the users of each step
# RAG_LOADTEST_STEP_SECONDS=60        # how long each step lasts
# RAG_LOADTEST_QUESTIONS=50           # distinct synthetic questions
# RAG_LOADTEST_QUESTIONS_FILE=        # ask this file's questions (rag-fetch-corpus writes one), not the synthetic ones
