# Copy to .env (git-ignored). Every variable has a default (src/rag_load_test/config/rag_settings.py).
RAG_TOPOLOGY=monolith        # monolith | split-reranker | split-all
# RAG_RUN_LABEL=             # default: topology + each choice off its default, e.g. monolith+rerank=none

# Each model component runs local (in this process), api (an endpoint: URL, API
# format, key, model name) or fake. The topology decides the embedding and
# rerank backends; only api, fake (or none for rerank) may override it. The
# backends and the model names stay commented out: the settings defaults are
# the pin (`rag-served-models` prints them), and a copy left here would win over
# a changed default.

# embedding
# RAG_EMBEDDING_BACKEND=     # local | api | fake (default: the topology's)
# RAG_EMBEDDING_MODEL=Snowflake/snowflake-arctic-embed-l-v2.0   # local model
RAG_EMBEDDING_API_URL=       # e.g. http://host:8000/v3/embeddings
RAG_EMBEDDING_API_FORMAT=openai
RAG_EMBEDDING_API_KEY=       # empty | domino | <bearer token>
# RAG_EMBEDDING_API_MODEL=snowflake-arctic-embed-l-v2.0   # name sent
# RAG_EMBEDDING_QUERY_PREFIX="query: "   # in front of each question; empty for a model that takes none

# rerank
# RAG_RERANK_BACKEND=        # local | api | fake | none
# RAG_RERANK_MODEL=antoinelouis/crossencoder-camembert-base-mmarcoFR
RAG_RERANK_API_URL=          # e.g. http://host:8000/v3/rerank
RAG_RERANK_API_FORMAT=cohere
RAG_RERANK_API_KEY=
# RAG_RERANK_API_MODEL=crossencoder-camembert-base-mmarcoFR

# generation
RAG_GENERATION_BACKEND=api   # api | fake
RAG_GENERATION_API_URL=https://api.openai.com/v1/chat/completions
RAG_GENERATION_API_FORMAT=openai
RAG_GENERATION_API_KEY=
RAG_GENERATION_API_MODEL=gpt-4o-mini
RAG_GENERATION_TEMPERATURE=0
# RAG_GENERATION_TIMEOUT_S=120   # an answer takes longer than a model-server call

# RAG_LOCAL_MODEL_RUNTIME=openvino    # openvino | torch: what runs the in-process models
# RAG_OPENVINO_MODELS_DIR=models/openvino   # where rag-export-openvino writes

RAG_VECTOR_STORE_BACKEND=elasticsearch # elasticsearch | chroma | fake (in-memory, seeded at start-up)
RAG_ES_URL=http://localhost:9200       # http://user:password@host:9200 for basic auth
RAG_ES_API_KEY=
# RAG_ES_TEXT_ANALYZER=standard        # or a language's, e.g. french; an index keeps the one it was created with
# RAG_CHROMA_PATH=chroma               # embedded Chroma's folder (pip install -e ".[chroma]")
# RAG_CHROMA_URL=                      # a Chroma server instead, e.g. http://localhost:8000
# RAG_CHROMA_COLLECTION=rag_passages

# RAG_RETRIEVAL_MODE=dense             # dense | lexical | hybrid
# RAG_HYBRID_RRF_K=60

RAG_DOMINO_TRACING=false
# host/port are rag-serve flags (default 0.0.0.0:8888, what Domino apps need)

# locust (client side)
# RAG_LOADTEST_BEARER_TOKEN=          # Authorization: Bearer ... (from inside Domino)
# DOMINO_API_KEY=                     # X-Domino-Api-Key: ... (from a laptop)
# RAG_LOADTEST_QUERY_WEIGHT=1
# RAG_LOADTEST_RETRIEVE_WEIGHT=3
# RAG_LOADTEST_SHAPE=step
# RAG_LOADTEST_QUESTIONS_FILE=        # ask this file's questions (rag-fetch-corpus writes one), not the synthetic ones
