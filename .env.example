# Copy to .env (git-ignored). Every variable has a default (src/rag_load_test/config/settings.py).
RAG_TOPOLOGY=monolith                 # monolith | split-reranker | split-all; sets both model backends
# RAG_RUN_LABEL=                      # default: topology + each backend off its default, e.g. monolith+reranker=none

# The topology decides these two; only a hosted API, fake (or none for the reranker) may override it.
# RAG_EMBEDDER_BACKEND=fake           # openai | fake
# RAG_RERANKER_BACKEND=none           # cohere | openai | fake | none

# Served models: the settings defaults are the pin (`rag-served-models` prints them).
# Uncomment only to override: a copy left here would win over a changed default.
# RAG_EMBEDDER_MODEL=Snowflake/snowflake-arctic-embed-l-v2.0
# RAG_RERANKER_MODEL=antoinelouis/crossencoder-camembert-base-mmarcoFR
# RAG_OVMS_EMBEDDINGS_MODEL=snowflake-arctic-embed-l-v2.0
# RAG_OVMS_RERANK_MODEL=crossencoder-camembert-base-mmarcoFR

RAG_OVMS_EMBEDDINGS_URL=http://localhost:8002
RAG_OVMS_RERANK_URL=http://localhost:8001
RAG_OVMS_AUTH=                        # empty | domino (run token) | <static bearer token>

# RAG_EMBEDDER_QUERY_PREFIX="query: " # in front of each question for RAG_EMBEDDER_MODEL; empty for a model that takes none
# RAG_LOCAL_MODEL_RUNTIME=openvino    # openvino | torch: what runs the in-process models
# RAG_OPENVINO_MODELS_DIR=models/openvino   # where rag-export-openvino writes

RAG_LLM_BACKEND=openai                # openai | fake
RAG_OPENAI_MODEL=gpt-4o-mini
# RAG_LLM_TEMPERATURE=0               # 0 to 2
OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://<domino-ai-gateway>/v1

# Hosted model APIs, in place of a model of ours (any topology).
# RAG_OPENAI_EMBEDDING_MODEL=text-embedding-3-small     # RAG_EMBEDDER_BACKEND=openai
# RAG_COHERE_RERANK_URL=https://api.cohere.com/v2/rerank # RAG_RERANKER_BACKEND=cohere
# RAG_COHERE_RERANK_MODEL=rerank-v3.5
# COHERE_API_KEY=
# RAG_OPENAI_RERANK_MODEL=            # RAG_RERANKER_BACKEND=openai: asked of $OPENAI_BASE_URL/rerank

RAG_VECTOR_STORE_BACKEND=elasticsearch # elasticsearch | chroma | fake (in-memory, seeded at start-up)
RAG_ES_URL=http://localhost:9200       # http://user:password@host:9200 for basic auth
RAG_ES_API_KEY=
# RAG_ES_TEXT_ANALYZER=standard        # or a language's, e.g. french; an index keeps the one it was created with
# RAG_CHROMA_PATH=chroma               # embedded Chroma's folder (pip install -e ".[chroma]")
# RAG_CHROMA_URL=                      # a Chroma server instead, e.g. http://localhost:8000
# RAG_CHROMA_COLLECTION=rag_passages

# RAG_RETRIEVAL_MODE=dense             # dense | lexical | hybrid
# RAG_HYBRID_RRF_K=60

RAG_DOMINO_TRACING=false
# host/port are rag-serve flags (default 0.0.0.0:8888, what Domino apps need)

# locust (client side)
# RAG_LOADTEST_BEARER_TOKEN=          # Authorization: Bearer ... (from inside Domino)
# DOMINO_API_KEY=                     # X-Domino-Api-Key: ... (from a laptop)
# RAG_LOADTEST_QUERY_WEIGHT=1
# RAG_LOADTEST_RETRIEVE_WEIGHT=3
# RAG_LOADTEST_SHAPE=step
# RAG_LOADTEST_QUESTIONS_FILE=        # ask this file's questions (rag-fetch-corpus writes one), not the synthetic ones
