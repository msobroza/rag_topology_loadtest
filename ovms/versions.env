# Single source of truth for the OpenVINO Model Server pin: version, image and
# binary URL. Sourced by export_models.sh, read by domino/Dockerfile and passed to
# docker compose with --env-file. The served models (source id and alias) are not
# pinned here: the RagSettings defaults in src/rag_load_test/config/settings.py pin them,
# and `rag-served-models` prints them.
OVMS_VERSION=2026.3.1
OVMS_IMAGE=openvino/model_server:2026.3.1
OVMS_BINARY_URL=https://github.com/openvinotoolkit/model_server/releases/download/v2026.3.1/ovms_ubuntu22_2026.3.1_python_off.tar.gz
