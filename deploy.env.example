# rag-deploy settings: cp deploy.env.example deploy.env, then edit (deploy.env is
# git-ignored). Run `make deploy` / `make status` from a Domino Workspace of the one
# project that hosts all the Apps.
#
# Secrets do NOT go here: values in this file are written into the Apps' launch
# scripts. Keep OPENAI_API_KEY, RAG_ES_API_KEY and any bearer token for
# RAG_OVMS_AUTH in Domino's project or user environment variables (rag-deploy
# refuses the last two in this file).

# monolith | split-reranker | split-all
RAG_DEPLOY_TOPOLOGY=split-all
# fastapi | ovms: what serves the models in the model server Apps
RAG_DEPLOY_MODEL_SERVER=fastapi
# Required: the Domino compute environment every App runs in (its id is in the URL
# of the environment's page in Domino). Any environment with `uv` works: the Apps
# install their own dependencies when they start.
RAG_DEPLOY_ENVIRONMENT_ID=
# Optional: the hardware tier id for every App; empty = the project's default.
RAG_DEPLOY_HARDWARE_TIER_ID=
# Required for ovms: the OVMS bundle as the Apps see it (project files or a Dataset),
# either a folder with bin/ovms and lib/ or the release .tar.gz.
RAG_DEPLOY_OVMS_BUNDLE=
# Optional: the project hosting the Apps; empty = DOMINO_PROJECT_ID (this Workspace's).
RAG_DEPLOY_PROJECT_ID=

# Any other RAG_* line is passed to every App as is. rag-deploy itself sets
# RAG_ROLE, RAG_TOPOLOGY, RAG_OVMS_RERANK_URL, RAG_OVMS_EMBEDDINGS_URL,
# RAG_OVMS_BUNDLE and RAG_BOOTSTRAP, and RAG_RUN_LABEL unless it is set here.
RAG_ES_URL=
# A local folder works as well as a Hugging Face id:
# RAG_EMBEDDER_MODEL=/mnt/data/models/bge-small-en-v1.5
# RAG_RERANKER_MODEL=/mnt/data/models/bge-reranker-base
# The folder holding config_reranker.json and config_embedder.json (ovms):
# RAG_OVMS_MODELS_DIR=/mnt/data/ovms-models
