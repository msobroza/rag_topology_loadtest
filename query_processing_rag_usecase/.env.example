# The RAG use case's environment: copy to .env in this directory (git-ignored),
# where every command of its Makefile runs and reads it. A value of the workflow
# file (workflow.yaml, here) is set here by the variable its path names, its levels
# joined by __; a value the file leaves out takes the toolkit's default
# (query_processing/src/query_processing/config/), which is never one of the RAG's
# models, prompts, sizes, index or collection.
# QP_RUN_LABEL=              # default: each component with its backend, e.g. embedder=local+router_embedder=local+router=local+reranker=local+llm=api+vector_store=elasticsearch
# QP_TOPOLOGY_ALIAS=         # a label only, sent as X-RAG-Topology (qp-deploy sets it); unset, no header

# The components (embedder, router_embedder, router, reranker, llm,
# vector_store) are declared in the workflow file (see below): each states its
# backend (for a model: local in this process, served by a model server of ours,
# api for an endpoint we do not run, fake, or none for the reranker; for the
# vector store: elasticsearch, chroma or fake; for the router: local, served or
# fake), a model its source id (the weights) and its alias (the name a model
# server serves it under: the source id's last part unless set), and one block
# of settings per backend. Their values stay there; a variable named by a
# value's path overrides one. Nothing else moves a component: to call one behind
# a model server you started, set its backend to served and its served URL (as
# qp-deploy does on Domino). A served component takes only its URL: no key
# (qp-serve --domino sends the Domino run token). An API key is set here or in
# the environment, never in the workflow file.
QP_COMPONENTS__LLM__API__API_KEY=             # the generation endpoint's key
# QP_COMPONENTS__LLM__BACKEND=fake              # served | api | fake
# QP_COMPONENTS__LLM__HTTP__TIMEOUT_S=120       # the workflow file's: an answer takes longer than a model-server call
# QP_COMPONENTS__LLM__HTTP__RETRIES=2           # a served or api component's http block: timeout_s, retries, backoff_s
# QP_COMPONENTS__EMBEDDER__BACKEND=served       # local | served | api | fake
# QP_COMPONENTS__EMBEDDER__SERVED__URL=         # e.g. http://host:8000/v3/embeddings
# QP_COMPONENTS__EMBEDDER__API__URL=            # an endpoint we do not run, e.g. https://api.openai.com/v1/embeddings
# QP_COMPONENTS__EMBEDDER__API__API_KEY=        # empty | domino | <bearer token>
# QP_COMPONENTS__EMBEDDER__LOCAL__THREADS=0     # 0 = calibrated at start-up
# QP_COMPONENTS__EMBEDDER__LOCAL__NORMALIZE=false   # unit-length vectors from the local embedder; stores compare by cosine either way
# QP_COMPONENTS__RERANKER__BACKEND=none         # local | served | api | fake | none
# QP_COMPONENTS__RERANKER__SERVED__URL=         # e.g. http://host:8000/v3/rerank
# QP_COMPONENTS__RERANKER__API__URL=            # an endpoint we do not run, e.g. https://api.cohere.com/v2/rerank
# QP_COMPONENTS__RERANKER__API__API_KEY=
# QP_COMPONENTS__RERANKER__LOCAL__BATCH_SIZE=0  # 0 = calibrated at start-up
# QP_COMPONENTS__RERANKER__LOCAL__THREADS=0
# QP_COMPONENTS__RERANKER__LOCAL__CALIBRATION_RECORDS=20   # calibration's rerank request; bounds the batch sizes tried
# The router and the embedder it reads, both local in the workflow file: the
# router loads the committed pipeline file (make train-router writes it again,
# with its manifest, on a machine that has Solon, after a change its manifest
# refuses), and its embedder Solon's weights. The first run, with no model
# weights, puts both on fake, as
# the four other components; the fake router always chooses the first of its
# routes, self_contained, so no message is rewritten.
# QP_COMPONENTS__ROUTER_EMBEDDER__BACKEND=fake  # local | served | api | fake
# QP_COMPONENTS__ROUTER__BACKEND=fake           # local | served | fake
# QP_COMPONENTS__ROUTER__LOCAL__PIPELINE_FILE=router_pipeline.joblib   # the workflow file's, as n_neighbors and metric: no default

# QP_COMPONENTS__VECTOR_STORE__BACKEND=elasticsearch    # elasticsearch | chroma | fake (in memory, seeded at start-up)
# QP_COMPONENTS__VECTOR_STORE__ELASTICSEARCH__URL=http://localhost:9200    # http://user:password@host:9200 for basic auth
QP_COMPONENTS__VECTOR_STORE__ELASTICSEARCH__API_KEY=    # an Elasticsearch API key, the alternative to basic auth
# QP_COMPONENTS__VECTOR_STORE__ELASTICSEARCH__INDEX=rag_passages    # the workflow file's; no default
# QP_COMPONENTS__VECTOR_STORE__ELASTICSEARCH__TEXT_ANALYZER=standard    # or a language's, e.g. french; an index keeps the one it was created with
# QP_COMPONENTS__VECTOR_STORE__CHROMA__PATH=chroma       # embedded Chroma's folder, here (the toolkit's [chroma] extra)
# QP_COMPONENTS__VECTOR_STORE__CHROMA__URL=              # a Chroma server instead, e.g. http://localhost:8000
# QP_COMPONENTS__VECTOR_STORE__CHROMA__COLLECTION=rag_passages  # required on chroma: the workflow file states only the store in use, and there is no default
# QP_COMPONENTS__VECTOR_STORE__FAKE__SEED_DOCUMENTS=200  # synthetic documents the fake store is seeded with

# What the components share: four more top-level blocks of the workflow file.
# The RAG's file writes the runtime and leaves the rest at these defaults (the
# toolkit's).
# QP_LOCAL_MODELS__RUNTIME=openvino             # the workflow file's; openvino | torch: what runs the in-process models
# QP_LOCAL_MODELS__OPENVINO_DIR=models/openvino    # where qp-export-openvino writes, here
# QP_LOCAL_MODELS__WORKERS=4                    # torch only: model calls at once
# QP_LOCAL_MODELS__CPUS=0                       # 0 = find out (Domino tier, else container)
# QP_LOCAL_MODELS__THREADS_PER_CORE=1           # 2 by default; 1 on a machine with hyper-threading off: OVMS's calibration tries no more streams than cores
# OpenVINO's CPU properties of the in-process models (README, "Variables"): only
# what a site changes, such as full precision on a CPU with AMX, to compare answers:
# QP_LOCAL_MODELS__OPENVINO__INFERENCE_PRECISION_HINT=f32
# QP_LOCAL_MODELS__OPENVINO__PROPERTIES='{"SCHEDULING_CORE_TYPE": "PCORE_ONLY"}'   # any other property; one also set by its named variable is refused here
# QP_CALIBRATION__BUDGET_S=90                   # per CPU-bound stage, at start-up or in qp-calibrate
# QP_CALIBRATION__ROUNDS=1                      # timed requests per candidate
# QP_HTTP__TIMEOUT_S=30                         # the default of each value a component's http block leaves out
# QP_HTTP__RETRIES=2
# QP_HTTP__BACKOFF_S=0.2                        # before the 1st retry; doubled before each next one
# The shared HTTP client's pool is httpx's own (100 connections, 20 kept alive, 5 s
# idle, HTTP/1.1): QP_HTTP__MAX_CONNECTIONS, QP_HTTP__MAX_KEEPALIVE_CONNECTIONS,
# QP_HTTP__KEEPALIVE_EXPIRY_S, QP_HTTP__HTTP2. Nothing here differs from it.
# QP_DOMINO__TOKEN_URL=http://localhost:8899/access-token
# QP_DOMINO__TOKEN_TTL_S=240
# QP_DOMINO__TRACING=false                      # wrap the workflow run with Domino tracing

# The components and the graph, its stages and their own settings (retrieval
# mode, sizes, the prompt a stage names), are read from a workflow file: the one QP_WORKFLOW_FILE
# names (environment only: it is not read from this file), else workflow.yaml in
# the working directory, this one's; with neither, a command stops, saying where
# it looked. Lexical retrieval is a file without the embed stage. A variable named
# by a value's path, its levels joined by __, overrides that value of the file:
# QP_GRAPH__STAGES__RETRIEVE__RETRIEVAL_MODE=dense    # dense | lexical | hybrid
# QP_GRAPH__STAGES__RETRIEVE__READS='["query_embedding", "metadata_filter"]'  # what the mode reads: ["standalone_query", "metadata_filter"] for lexical, both queries then the filter for hybrid
# QP_GRAPH__STAGES__RETRIEVE__TOP_K=20                # candidates from the store
# QP_GRAPH__STAGES__RETRIEVE__RRF_K=60                # rank constant of the hybrid fusion
# QP_GRAPH__STAGES__RERANK__TOP_K=10                  # vector-store records kept and sent to the LLM
# QP_GRAPH__STAGES__GENERATE__PROMPT=answer_from_context  # a prompt of prompts.yaml
# QP_GRAPH__STAGES__GENERATE__MAX_TOKENS=128          # the most tokens its answer may hold, sent to the LLM; unset = no cap
# The prompts are read from prompts.yaml, the one QP_PROMPTS_FILE names, else
# this one's; a variable named by a prompt's path replaces it, as JSON:
# QP_PROMPTS__ANSWER_FROM_CONTEXT='[{"role": "user", "content": "{{ conversational_query }}"}]'
# The routes the router chooses between are read from routes.yaml, the one
# QP_ROUTES_FILE names, else this one's.

# host/port are qp-serve flags (default 0.0.0.0:8888, what Domino apps need)
# What a process of qp-serve or qp-model-server runs as, each at Uvicorn's own
# default (README, "Variables"): QP_UVICORN_WORKERS, QP_UVICORN_LIMIT_CONCURRENCY,
# QP_UVICORN_BACKLOG, QP_UVICORN_TIMEOUT_KEEP_ALIVE_S. On Domino, replicas, not workers.
# QP_PROCESS_MEMORY_ALLOCATOR_LIBRARY=/usr/lib/x86_64-linux-gnu/libjemalloc.so.2   # preloaded by one restart; the environment must hold the library
# QP_PROCESS_OMP_PROC_BIND=close                # torch only; OpenVINO pins its own threads

# locust (client side), run here by make loadtest with the toolkit's locustfile.py.
# A model-server target also reads QP_COMPONENTS__RERANKER__ALIAS and
# QP_COMPONENTS__EMBEDDER__ALIAS (default: this workflow file's aliases), and
# the rerank target the documents and top_n of each rerank request, the RAG's
# retrieve and rerank sizes (its workflow file's top_k): the toolkit has no
# default for them, and the workflow app does not read them.
QP_TOP_K_RETRIEVE=20
QP_TOP_K_RERANK=10
# QP_LOADTEST_TARGET=rag              # rag | rerank | embeddings (a model server directly)
# QP_LOADTEST_BEARER_TOKEN=           # Authorization: Bearer ... (from inside Domino)
# DOMINO_API_KEY=                     # X-Domino-Api-Key: ... (from a laptop)
# QP_LOADTEST_QUERY_WEIGHT=1
# QP_LOADTEST_RETRIEVE_WEIGHT=3
# QP_LOADTEST_WAIT_MIN_S=0.2          # each user waits between min and max seconds between requests
# QP_LOADTEST_WAIT_MAX_S=1.0
# QP_LOADTEST_SHAPE=step              # step or unset
# QP_LOADTEST_STEP_USERS=5,10,20,40   # the users of each step
# QP_LOADTEST_STEP_SECONDS=60         # how long each step lasts
# QP_LOADTEST_QUESTIONS=50            # distinct synthetic questions
# QP_LOADTEST_QUESTIONS_FILE=         # ask this file's questions (qp-fetch-corpus writes one under data/, here), not the synthetic ones
