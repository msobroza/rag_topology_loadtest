# The RAG use case's environment: copy to .env in this directory (git-ignored),
# where every command of its Makefile runs and reads it. A value of the workflow
# file (workflow.yaml, here) is set here by the variable its path names, its levels
# joined by __; a value the file leaves out takes the toolkit's default
# (query_processing/src/rag_load_test/config/), which is never one of the RAG's
# models, prompts, sizes, index or collection.
# RAG_RUN_LABEL=             # default: each component with its backend, e.g. embedder=local+reranker=local+llm=api+vector_store=elasticsearch
# RAG_TOPOLOGY_ALIAS=        # a label only, sent as X-RAG-Topology (rag-deploy sets it); unset, no header

# The components (embedder, reranker, llm, vector_store) are declared in the
# workflow file (see below): each states its backend (for a model: local in this
# process, served by a model server of ours, api for an endpoint we do not run,
# fake, or none for the reranker; for the vector store: elasticsearch, chroma or
# fake), a model its source id (the weights) and its alias (the name a model
# server serves it under: the source id's last part unless set), and one block
# of settings per backend. Their values stay there; a variable named by a
# value's path overrides one. Nothing else moves a component: to call one behind
# a model server you started, set its backend to served and its served URL (as
# rag-deploy does on Domino). A served component takes only its URL: no key
# (rag-serve --domino sends the Domino run token). An API key is set here or in
# the environment, never in the workflow file.
RAG_COMPONENTS__LLM__API__API_KEY=            # the generation endpoint's key
# RAG_COMPONENTS__LLM__BACKEND=fake             # served | api | fake
# RAG_COMPONENTS__LLM__HTTP__TIMEOUT_S=120      # the workflow file's: an answer takes longer than a model-server call
# RAG_COMPONENTS__LLM__HTTP__RETRIES=2          # a served or api component's http block: timeout_s, retries, backoff_s
# RAG_COMPONENTS__EMBEDDER__BACKEND=served      # local | served | api | fake
# RAG_COMPONENTS__EMBEDDER__SERVED__URL=        # e.g. http://host:8000/v3/embeddings
# RAG_COMPONENTS__EMBEDDER__API__URL=           # an endpoint we do not run, e.g. https://api.openai.com/v1/embeddings
# RAG_COMPONENTS__EMBEDDER__API__API_KEY=       # empty | domino | <bearer token>
# RAG_COMPONENTS__EMBEDDER__LOCAL__THREADS=0    # 0 = calibrated at start-up
# RAG_COMPONENTS__RERANKER__BACKEND=none        # local | served | api | fake | none
# RAG_COMPONENTS__RERANKER__SERVED__URL=        # e.g. http://host:8000/v3/rerank
# RAG_COMPONENTS__RERANKER__API__URL=           # an endpoint we do not run, e.g. https://api.cohere.com/v2/rerank
# RAG_COMPONENTS__RERANKER__API__API_KEY=
# RAG_COMPONENTS__RERANKER__LOCAL__BATCH_SIZE=0 # 0 = calibrated at start-up
# RAG_COMPONENTS__RERANKER__LOCAL__THREADS=0
# RAG_COMPONENTS__RERANKER__LOCAL__CALIBRATION_PASSAGES=20  # calibration's rerank request; bounds the batch sizes tried

# RAG_COMPONENTS__VECTOR_STORE__BACKEND=elasticsearch   # elasticsearch | chroma | fake (in memory, seeded at start-up)
# RAG_COMPONENTS__VECTOR_STORE__ELASTICSEARCH__URL=http://localhost:9200   # http://user:password@host:9200 for basic auth
RAG_COMPONENTS__VECTOR_STORE__ELASTICSEARCH__API_KEY=   # an Elasticsearch API key, the alternative to basic auth
# RAG_COMPONENTS__VECTOR_STORE__ELASTICSEARCH__INDEX=rag_passages   # the workflow file's; no default
# RAG_COMPONENTS__VECTOR_STORE__ELASTICSEARCH__TEXT_ANALYZER=standard   # or a language's, e.g. french; an index keeps the one it was created with
# RAG_COMPONENTS__VECTOR_STORE__CHROMA__PATH=chroma      # embedded Chroma's folder, here (the toolkit's [chroma] extra)
# RAG_COMPONENTS__VECTOR_STORE__CHROMA__URL=             # a Chroma server instead, e.g. http://localhost:8000
# RAG_COMPONENTS__VECTOR_STORE__CHROMA__COLLECTION=rag_passages # the workflow file's; no default
# RAG_COMPONENTS__VECTOR_STORE__FAKE__SEED_DOCUMENTS=200 # synthetic documents the fake store is seeded with

# What the components share: four more top-level blocks of the workflow file,
# which the RAG's file leaves at these defaults (the toolkit's).
# RAG_LOCAL_MODELS__RUNTIME=openvino            # openvino | torch: what runs the in-process models
# RAG_LOCAL_MODELS__OPENVINO_DIR=models/openvino   # where rag-export-openvino writes, here
# RAG_LOCAL_MODELS__WORKERS=4                   # torch only: model calls at once
# RAG_LOCAL_MODELS__CPUS=0                      # 0 = find out (Domino tier, else container)
# RAG_CALIBRATION__BUDGET_S=90                  # per CPU-bound stage, at start-up or in rag-calibrate
# RAG_CALIBRATION__ROUNDS=1                     # timed requests per candidate
# RAG_HTTP__TIMEOUT_S=30                        # the default of each value a component's http block leaves out
# RAG_HTTP__RETRIES=2
# RAG_HTTP__BACKOFF_S=0.2                       # before the 1st retry; doubled before each next one
# RAG_DOMINO__TOKEN_URL=http://localhost:8899/access-token
# RAG_DOMINO__TOKEN_TTL_S=240
# RAG_DOMINO__TRACING=false                     # wrap the workflow run with Domino tracing

# The components and the graph, its stages and their own settings (retrieval
# mode, sizes, prompts), are read from a workflow file: the one RAG_WORKFLOW_FILE
# names (environment only: it is not read from this file), else workflow.yaml in
# the working directory, this one's; with neither, a command stops, saying where
# it looked. Lexical retrieval is a file without the embed stage. A variable named
# by a value's path, its levels joined by __, overrides that value of the file:
# RAG_GRAPH__STAGES__RETRIEVE__RETRIEVAL_MODE=dense   # dense | lexical | hybrid
# RAG_GRAPH__STAGES__RETRIEVE__TOP_K=20               # candidates from the store
# RAG_GRAPH__STAGES__RETRIEVE__RRF_K=60               # rank constant of the hybrid fusion
# RAG_GRAPH__STAGES__RERANK__TOP_K=10                 # passages kept and sent to the LLM
# RAG_GRAPH__STAGES__GENERATE__SYSTEM_PROMPT="..."
# RAG_GRAPH__STAGES__GENERATE__USER_PROMPT="... {context} ... {question}"

# host/port are rag-serve flags (default 0.0.0.0:8888, what Domino apps need)

# locust (client side), run here by make loadtest with the toolkit's locustfile.py.
# A model-server target also reads RAG_COMPONENTS__RERANKER__ALIAS and
# RAG_COMPONENTS__EMBEDDER__ALIAS (default: this workflow file's aliases), and
# the rerank target the documents and top_n of each rerank request, the RAG's
# retrieve and rerank sizes (its workflow file's top_k): the toolkit has no
# default for them, and the workflow app does not read them.
RAG_TOP_K_RETRIEVE=20
RAG_TOP_K_RERANK=10
# RAG_LOADTEST_TARGET=rag             # rag | rerank | embeddings (a model server directly)
# RAG_LOADTEST_BEARER_TOKEN=          # Authorization: Bearer ... (from inside Domino)
# DOMINO_API_KEY=                     # X-Domino-Api-Key: ... (from a laptop)
# RAG_LOADTEST_QUERY_WEIGHT=1
# RAG_LOADTEST_RETRIEVE_WEIGHT=3
# RAG_LOADTEST_WAIT_MIN_S=0.2         # each user waits between min and max seconds between requests
# RAG_LOADTEST_WAIT_MAX_S=1.0
# RAG_LOADTEST_SHAPE=step             # step or unset
# RAG_LOADTEST_STEP_USERS=5,10,20,40  # the users of each step
# RAG_LOADTEST_STEP_SECONDS=60        # how long each step lasts
# RAG_LOADTEST_QUESTIONS=50           # distinct synthetic questions
# RAG_LOADTEST_QUESTIONS_FILE=        # ask this file's questions (rag-fetch-corpus writes one under data/, here), not the synthetic ones
