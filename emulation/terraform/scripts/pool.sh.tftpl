# --- A pool machine of a hardware tier: where the fake Domino runs one App ---
# Rendered by Terraform (machines.tf) after scripts/common.sh. In this template
# Terraform substitutes dollar-brace expressions, so the bash below never uses
# braces after a dollar sign.

REPO_URL='${repo_url}'
GIT_REF='${git_ref}'
REPO_PATH='${repo_path}'
UV_VERSION='${uv_version}'
OVMS_BUNDLE='${ovms_bundle_path}'
WORKSPACE_ADDRESS='${workspace_address}'
DOMINO_PORT='${domino_port}'
CACHE_BUCKET='${cache_bucket}'
DATASET_PATH='${dataset_path}'

# warm_app_dependencies: app.sh's install_project, run once at boot with what an
# App's launch script asks for, by the same absolute paths (the clone has the same
# path on every machine): the core, the toolkit, then the use case of QP_USE_CASE_DIR, the
# directory qp-deploy runs from on the Workspace, doclang's core found among the wheels
# restore_wheels copied (QP_BOOTSTRAP_WHEELS, the folder deploy.yaml hands the Apps
# too: sudo passes no variable, so it is the bash's $2). app.sh runs these two commands
# at every App start; done here they fill uv's cache, so an App's own install
# takes seconds. "[domino]" because an Agent's launch script asks for that extra
# (QP_BOOTSTRAP_EXTRAS) and it is a superset of the plain install.
warm_app_dependencies() {
  retry 3 30 as_ubuntu timeout 900 bash -c 'uv venv "$HOME/qp-venv" --python "$(cat "$1/.python-version")"' _ "$REPO_PATH"
  retry 3 30 as_ubuntu timeout 1800 bash -c 'uv pip install --python "$HOME/qp-venv/bin/python" --find-links "$2" "$1/query_processing_core" "$1/query_processing[domino]" "$1/query_processing_rag_usecase"' _ "$REPO_PATH" "$QP_BOOTSTRAP_WHEELS"
}

ensure_ubuntu_user
# libxml2 is what app.sh's OVMS bootstrap would apt-get; installed here, it is ready.
apt_install git curl socat python3 ca-certificates libxml2
install_uv "$UV_VERSION"
sync_repo "$REPO_URL" "$GIT_REF" "$REPO_PATH"
# The models an earlier sitting exported, into the folder deploy.yaml points the Apps at.
write_cache_config "$CACHE_BUCKET" "$DATASET_PATH"
restore_cached_models "$CACHE_BUCKET" "$CACHE_MODELS_PREFIX" "$DATASET_PATH"
# doclang's core, from the bucket: for the install below and the Apps' own.
restore_wheels "$CACHE_BUCKET" "$DATASET_PATH"
warm_app_dependencies
fetch_ovms_bundle "$REPO_PATH/query_processing" "$OVMS_BUNDLE"

# Domino's sidecar on localhost:8899 (run token, Domino API) is the fake Domino on
# the Workspace machine: Apps reach it at the same address as on Domino.
install_service rag-domino-sidecar <<UNIT
[Unit]
Description=Forward localhost:$DOMINO_PORT to the fake Domino, as Domino's sidecar
Wants=network-online.target
After=network-online.target

[Service]
DynamicUser=yes
ExecStart=/usr/bin/socat TCP-LISTEN:$DOMINO_PORT,bind=127.0.0.1,fork,reuseaddr TCP:$WORKSPACE_ADDRESS:$DOMINO_PORT,connect-timeout=10
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
UNIT

guest_attribute startup "done"
log "pool machine ready"
