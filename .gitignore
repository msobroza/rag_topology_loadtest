# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Distribution / packaging
build/
dist/
.eggs/
wheels/
*.egg-info/
*.egg

# Virtual environments
.venv/
venv/
env/
ENV/

# Test / coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
.tox/
.nox/
.mypy_cache/
.ruff_cache/

# Editors / OS
.idea/
.vscode/
*.swp
.DS_Store

# The toolkit's commands run from query_processing/, so what they write is there.
# Load-test output (keep the directory), exported OVMS models, secrets
/query_processing/results/*
!/query_processing/results/.gitkeep
/query_processing/ovms/models/
.env
deploy.env
# rag-deploy: its settings and the App ids it has seen
deploy.yaml
.rag-deploy-cache.json

# Written at run time by the defaults: the OpenVINO exports (RAG_LOCAL_MODELS__OPENVINO_DIR)
# and the embedded Chroma store (RAG_COMPONENTS__VECTOR_STORE__CHROMA__PATH).
/query_processing/models/
/query_processing/chroma/

# A fetched corpus (rag-fetch-corpus): never committed.
/query_processing/data/
