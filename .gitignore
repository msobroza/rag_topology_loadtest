# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Distribution / packaging
build/
dist/
.eggs/
wheels/
*.egg-info/
*.egg

# Virtual environments
.venv/
venv/
env/
ENV/
# Not a virtual environment: the env key source's package.
!query_processing/src/query_processing/adapters/key_source/env/

# Test / coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
.tox/
.nox/
.mypy_cache/
.ruff_cache/

# Editors / OS
.idea/
.vscode/
*.swp
.DS_Store

# The commands run from the use case's directory, so a relative output path
# lands there. Load-test output (keep the directory), exported OVMS models, secrets
/query_processing_rag_usecase/results/*
!/query_processing_rag_usecase/results/.gitkeep
/query_processing_rag_usecase/ovms/models/
.env
deploy.env
# qp-deploy: its settings and the App ids it has seen
deploy.yaml
.qp-deploy-cache.json

# Written at run time by the defaults: the OpenVINO exports (QP_LOCAL_MODELS__OPENVINO_DIR)
# and the embedded Chroma store (QP_COMPONENTS__VECTOR_STORE__CHROMA__PATH).
/query_processing_rag_usecase/models/
/query_processing_rag_usecase/chroma/

# A fetched corpus (qp-fetch-corpus): never committed.
/query_processing_rag_usecase/data/

# Working notes of a session (tickets, briefs, review notes): they name local
# paths, and a test of the gate reads every file git does not ignore.
.scratch/
